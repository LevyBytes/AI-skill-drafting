{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "preserve",
              "rewrite",
              "exclude"
            ]
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_ranges": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "code": {
            "enum": [
              "preserve",
              "repair"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "behavior_check": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "action",
          "outputs",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "created": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviews": {
      "type": "object",
      "properties": {
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "source_fidelity": {
          "type": "string",
          "minLength": 1
        },
        "behavior": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "organization",
        "source_fidelity",
        "behavior"
      ],
      "additionalProperties": false
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "enum": [
              "suspect_ordinal_or_hash_name",
              "unrendered_component_or_literal"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "code",
          "sha256",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "name",
    "roots",
    "sources",
    "created",
    "reviews"
  ],
  "additionalProperties": false
}
