{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "minLength": 1
          },
          "frontmatter": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "description": {
                "type": "string",
                "pattern": "^Use ",
                "maxLength": 1023
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "compatibility": {
                "type": "string",
                "maxLength": 500
              },
              "allowed-tools": {
                "type": "string",
                "minLength": 1
              },
              "metadata": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "required": [
                  "last-updated"
                ]
              }
            },
            "required": [
              "name",
              "description",
              "metadata"
            ],
            "additionalProperties": false
          },
          "official_source": {
            "type": "string",
            "pattern": "^https?://"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "topic": {
                  "type": "string",
                  "minLength": 1
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "pattern": "^Open when "
                },
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "topic",
                "file",
                "summary",
                "keywords",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "translations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "language": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source",
                "file",
                "language",
                "label",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "root": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "pattern": "^Open when "
                }
              },
              "required": [
                "root",
                "label",
                "summary"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "root",
          "frontmatter",
          "official_source",
          "topics"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "skills"
  ],
  "additionalProperties": false
}
